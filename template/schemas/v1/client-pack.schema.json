{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abrosdaniel/anthub/HEAD/template/schemas/v1/client-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "required",
              "recommended",
              "optional"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "maxItems": 2000,
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "maxItems": 2000,
            "uniqueItems": true
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "repositoryPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "policy": {
                  "enum": [
                    "enforce",
                    "update",
                    "preserve"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                  }
                }
              },
              "required": [
                "path"
              ],
              "anyOf": [
                {
                  "required": [
                    "urls"
                  ]
                },
                {
                  "required": [
                    "repositoryPath"
                  ]
                }
              ]
            },
            "maxItems": 10000
          }
        },
        "required": [
          "id",
          "name",
          "files"
        ]
      },
      "maxItems": 2000
    }
  },
  "required": [
    "components"
  ]
}
