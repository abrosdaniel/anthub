{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abrosdaniel/anthub/HEAD/template/schemas/v1/project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "news": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "changelog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": []
    },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "loader": {
          "const": "neoforge"
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "version",
        "loaderVersion"
      ]
    },
    "anthub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "minVersion"
      ]
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customFiles": {
          "enum": [
            "warn",
            "deny"
          ]
        }
      },
      "required": [
        "customFiles"
      ]
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "luckperms": {
          "type": "boolean"
        }
      },
      "required": [
        "luckperms"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "logo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "banner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": []
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "address"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": ".*\\S.*"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "required",
              "recommended",
              "optional"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "maxItems": 2000,
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "maxItems": 2000,
            "uniqueItems": true
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "repositoryPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "policy": {
                  "enum": [
                    "enforce",
                    "update",
                    "preserve"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                  }
                }
              },
              "required": [
                "path"
              ],
              "anyOf": [
                {
                  "required": [
                    "urls"
                  ]
                },
                {
                  "required": [
                    "repositoryPath"
                  ]
                }
              ]
            },
            "maxItems": 10000
          }
        },
        "required": [
          "id",
          "name",
          "files"
        ]
      },
      "maxItems": 2000
    }
  },
  "required": [
    "name",
    "version",
    "server",
    "minecraft",
    "components"
  ]
}
