{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abrosdaniel/anthub/HEAD/anthub/core/src/main/resources/anthub/schemas/v1/registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "repository"
        ]
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "projects"
  ]
}
