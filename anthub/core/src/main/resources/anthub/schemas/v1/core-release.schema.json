{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abrosdaniel/anthub/HEAD/anthub/core/src/main/resources/anthub/schemas/v1/core-release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minecraft": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "neoForge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Minimum NeoForge version within the same major.minor release line."
          },
          "java": {
            "type": "integer",
            "minimum": 21
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "helperProtocolVersion": {
            "const": 1
          }
        },
        "required": [
          "minecraft",
          "neoForge",
          "java",
          "url",
          "sha256",
          "size",
          "helperProtocolVersion"
        ]
      },
      "maxItems": 100,
      "minItems": 1
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "auth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "menu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "helper": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "pack",
        "auth",
        "menu",
        "helper"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "artifacts",
    "protocols"
  ]
}
